# Terraform state files (contain secrets — never commit)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plan output
*.tfplan

# Your actual variable values (contain passwords — never commit)
terraform.tfvars
backend.hcl

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Crash log files
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

./webapp-logs/*