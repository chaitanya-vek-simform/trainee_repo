# ─────────────────────────────────────────────────────────────────────────────
# terraform.tfvars.example
#
# HOW TO USE:
#   cp terraform.tfvars.example terraform.tfvars
#   Then edit terraform.tfvars with your real values.
#
# IMPORTANT: Never commit terraform.tfvars to Git — it contains secrets!
#            Add "terraform.tfvars" to your .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# Your Azure Subscription ID
# Find it: Azure Portal → search "Subscriptions" → copy the GUID
subscription_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Resource Group name — will be created by Terraform
resource_group_name = "rg-trainee-app"

# Azure region
# Options: eastus, westus2, westeurope, southindia, etc.
location = "eastus"

# Environment tag
environment = "dev"

# ── Networking ──
vnet_address_space    = "10.0.0.0/16"
subnet_appgw_prefix   = "10.0.1.0/24"
subnet_backend_prefix = "10.0.2.0/24"
subnet_db_prefix      = "10.0.3.0/24"

# ── ACR ──
# Must be globally unique, lowercase letters and numbers only, 5–50 chars
acr_name = "mytraineeacr"

# ── MySQL Database ──
# Server name must be globally unique
mysql_server_name    = "trainee-mysql-server"
mysql_admin_username = "mysqladmin"
# Password requirements: 8+ chars, uppercase, lowercase, number, symbol
mysql_admin_password = "YourStr0ng!Password"
mysql_sku            = "B_Standard_B1ms"

# ── App Service (Backend) ──
app_service_plan_name = "asp-trainee"
backend_app_name      = "trainee-backend-app"  # Must be globally unique
backend_image_tag     = "latest"

# ── Storage Account (Frontend) ──
# Must be globally unique, lowercase letters and numbers, 3–24 chars, NO hyphens
storage_account_name = "traineeappstorage"

# ── Application Gateway ──
app_gateway_name = "agw-trainee"

# ─────────────────────────────────────────────────────────────────────────────
# PHASE CONTROL — Read Part 13 (Student Subscription Guide) first!
# ─────────────────────────────────────────────────────────────────────────────

# App Service Plan tier:
#   "F1" → Phase 1 (Free, ~$0/mo) — NO VNet, NO always_on
#   "B1" → Phase 2+ (Basic, ~$13/mo) — supports VNet integration
# Student recommendation: Start with F1, switch to B1 before adding App Gateway
app_service_plan_sku = "F1"

# WAF (Web Application Firewall) toggle:
#   false → Standard_v2 App Gateway (no WAF) — Phase 1 and 2
#   true  → WAF_v2 tier + OWASP 3.2 ruleset — Phase 3 only
# WARNING: Setting to true increases App Gateway cost by ~$20-30/month!
# Student recommendation: Keep false until final demo
enable_waf = false
